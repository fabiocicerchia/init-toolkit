#!/usr/bin/env bash
# wait-for — one front door for the common readiness checks.
#
#   wait-for tcp://db:5432 [tcp://redis:6379 ...] [-t 60] [-- cmd args...]
#   wait-for http://api:8080/healthz [-t 60] [-- cmd args...]
#
# TCP targets use netcat, HTTP(S) targets must answer 2xx/3xx.
set -euo pipefail

TIMEOUT=60
TARGETS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -t|--timeout) TIMEOUT="$2"; shift 2 ;;
    --help|-h) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; break ;;
    *) TARGETS+=("$1"); shift ;;
  esac
done

[[ ${#TARGETS[@]} -gt 0 ]] || { echo "wait-for: no targets given (see --help)" >&2; exit 64; }

wait_one() {
  local target="$1" deadline=$(( $(date +%s) + TIMEOUT ))
  while true; do
    case "$target" in
      tcp://*)
        local hostport="${target#tcp://}"
        nc -z "${hostport%%:*}" "${hostport##*:}" 2>/dev/null && return 0 ;;
      http://*|https://*)
        curl -sfo /dev/null --max-time 5 "$target" && return 0 ;;
      *)
        echo "wait-for: unsupported scheme in '$target'" >&2; return 64 ;;
    esac
    [[ $(date +%s) -lt $deadline ]] || { echo "wait-for: timeout waiting for $target" >&2; return 1; }
    sleep 1
  done
}

for t in "${TARGETS[@]}"; do
  echo "wait-for: waiting for $t (timeout ${TIMEOUT}s)"
  wait_one "$t"
  echo "wait-for: $t is up"
done

[[ $# -eq 0 ]] || exec "$@"
